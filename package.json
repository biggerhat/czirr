{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "NODE_OPTIONS=--max-old-space-size=4096 vite build && cp public/build/sw.js public/sw.js 2>/dev/null; cp public/build/manifest.webmanifest public/manifest.webmanifest 2>/dev/null; true",
        "build:ssr": "NODE_OPTIONS=--max-old-space-size=4096 vite build && NODE_OPTIONS=--max-old-space-size=4096 vite build --ssr && cp public/build/sw.js public/sw.js 2>/dev/null; cp public/build/manifest.webmanifest public/manifest.webmanifest 2>/dev/null; true",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "generate-pwa-assets": "pwa-assets-generator --preset minimal-2023 public/favicon.svg",
        "lint": "eslint . --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^22.13.5",
        "@vite-pwa/assets-generator": "^1.0.2",
        "@vitejs/plugin-vue": "^6.0.11",
        "@vue/eslint-config-typescript": "^14.9.0",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "prettier": "^3.10.1",
        "prettier-plugin-tailwindcss": "^0.8.1",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vite-plugin-pwa": "^1.2.0",
        "vue-tsc": "^3.3.14"
    },
    "dependencies": {
        "@inertiajs/vue3": "^3.11.0",
        "@vueuse/core": "^15.0.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.6.3",
        "laravel-vite-plugin": "^2.0.0",
        "lucide-vue-next": "^0.468.0",
        "pusher-js": "^8.6.0",
        "reka-ui": "^2.11.0",
        "rrule": "^2.8.1",
        "tailwind-merge": "^3.7.1",
        "tailwindcss": "^4.3.5",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.46",
        "vue-input-otp": "^0.4.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.68.8",
        "@rollup/rollup-win32-x64-msvc": "4.68.8",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
